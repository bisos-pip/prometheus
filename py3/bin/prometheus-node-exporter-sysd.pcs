""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.prometheus/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
The prometheus-node-exporter.service unit: this host's metrics, scraped by Prometheus.
The unit name is Debian's. It runs as the prometheus account, as Debian's package does.
Flags come from ARGS in /etc/default/prometheus-node-exporter.
#+end_org """

from bisos.debian import systemd_seedInfo
from bisos.debian import systemd_seed as systemd_seed  # noqa

from bisos.prometheus.prometheusInfo import prometheusInfo, sysdServiceLines

def sysdUnitFileFunc() -> str | None:
    """Produce the unit file as a string."""

    if not ( execPath := prometheusInfo.nodeExporterBin ).exists():
        return None

    templateStr = f"""
[Unit]
Description=Prometheus node_exporter (this host's metrics)
After=network.target

[Service]
Type=simple
{sysdServiceLines(prometheusInfo.nodeExporterEnvFile)}ExecStart={execPath} $ARGS
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
"""
    return templateStr

systemd_seedInfo.setup(
    seedType="sysdSysUnit",
    sysdUnitName="prometheus-node-exporter",
    sysdUnitFileFunc=sysdUnitFileFunc,
)

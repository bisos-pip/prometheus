#!/usr/bin/env python

""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.prometheus/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
prometheus-sbom.pcs: software bill of materials of the Prometheus hereWeb capability ---
the Prometheus server and this host's node_exporter, which it scrapes.
Both are fetched from upstream at pinned versions, verified against pinned checksums, by
func-bearing pseudo-packages. Debian's prometheus package is 2.x; upstream is 3.x.
This is the server only. The usage side (promtool) is prometheusUsage-sbom.pcs, which this
sbom does not pull in; prometheusCbs-sbom.pcs, the sbom of prometheus-cbs.pcs, runs both.
#+end_org """

from bisos import b
from bisos.b import cs
from bisos.b import b_io

from bisos.sbom import pkgsSeed  # pkgsSeed.plantWithWhich("seedSbom.cs")
from bisos.banna import sysAccts
from bisos.prometheus.prometheusInfo import (
    prometheusInfo, promDistSetupScript, nodeExporterSetupScript,
    configFileContent, envFileContent, nodeExporterEnvFileContent,
)

ap = pkgsSeed.aptPkg

# The facts of the installation --- account, versions, checksums, paths, env files,
# ports --- come from bisos.prometheus.prometheusInfo, the one source the units,
# prometheusAdmin.cs, dns and vhost read too.
#
# Each func-bearing pseudo-package below is registered in aptPkgsList, so sbom_csu's
# aptPkgs_update() calls it instead of apt-get install. Its gate,
# aptPkg_isInstalled("<name>"), can never be true --- so each runs on *every*
# sbom_fullUpdate and must stay idempotent. Ordering in aptPkgsList is load-bearing.


def _bash(script: str) -> b.op.Outcome:
    outcome = b.subProc.WOpW(invedBy=None, log=1).bash(script)
    if outcome.isProblematic():
        b_io.eh.badOutcome(outcome)
    return outcome


def prometheusAcctSetup():
    """The prometheus system account and the dirs it must own. Not an apt package.

    The uid/gid come from bisos.banna.sysAccts, so the account has the same numbers on
    every BISOS platform.
    """
    return _bash(f"""
set -e
{sysAccts.useraddScript(prometheusInfo.acctName)}

sudo mkdir -p {prometheusInfo.dataDir} {prometheusInfo.confDir} {prometheusInfo.installBase}
sudo chown -R {prometheusInfo.acctName}:{prometheusInfo.acctName} {prometheusInfo.dataDir.parent}
sudo chmod 750 {prometheusInfo.dataDir}
""")


def prometheusDistSetup():
    """The pinned Prometheus tarball, verified, unpacked root-owned, current -> it. Not an apt package."""
    return _bash(promDistSetupScript())


def nodeExporterDistSetup():
    """The pinned node_exporter tarball, verified, unpacked, node_exporter -> it. Not an apt package."""
    return _bash(nodeExporterSetupScript())


def prometheusConfSetup():
    """prometheus.yml and the two EnvironmentFiles. Not an apt package.

    Written only when absent, so hand overrides survive re-runs; prometheusAdmin.cs -i
    driftCheck reports how they differ from the generators. prometheus.yml is then checked
    with promtool: a config Prometheus would refuse is reported here, not at unit start.
    """
    return _bash(f"""
set -e
if [ ! -f {prometheusInfo.configFile} ] ; then
    sudo tee {prometheusInfo.configFile} >/dev/null <<'PROM_YML_EOF'
{configFileContent()}PROM_YML_EOF
fi
sudo chown root:{prometheusInfo.acctName} {prometheusInfo.configFile}
sudo chmod 640 {prometheusInfo.configFile}

if [ ! -f {prometheusInfo.envFile} ] ; then
    sudo tee {prometheusInfo.envFile} >/dev/null <<'PROM_ENV_EOF'
{envFileContent()}PROM_ENV_EOF
fi
if [ ! -f {prometheusInfo.nodeExporterEnvFile} ] ; then
    sudo tee {prometheusInfo.nodeExporterEnvFile} >/dev/null <<'NODE_ENV_EOF'
{nodeExporterEnvFileContent()}NODE_ENV_EOF
fi
sudo chown root:{prometheusInfo.acctName} {prometheusInfo.envFile} {prometheusInfo.nodeExporterEnvFile}
sudo chmod 640 {prometheusInfo.envFile} {prometheusInfo.nodeExporterEnvFile}

sudo -u {prometheusInfo.acctName} {prometheusInfo.promtool} check config {prometheusInfo.configFile}
""")


aptPkgsList = [
    ap("curl"),                                                 # Fetches the upstream tarballs
    ap("prometheusAcctSetup", func=prometheusAcctSetup),
    ap("prometheusDistSetup", func=prometheusDistSetup),       # after curl and the account dirs
    ap("nodeExporterDistSetup", func=nodeExporterDistSetup),
    ap("prometheusConfSetup", func=prometheusConfSetup),       # after the dist: the check needs promtool
]

# No pip packages, and nothing for using Prometheus from elsewhere: that is prometheusUsage-sbom.pcs.

pkgsSeed.setup(
    aptPkgsList=aptPkgsList,
)


####+BEGIN: b:py3:cs:cmnd/classHead :cmndName "readme" :extent "verify" :comment "Describe" :parsMand "" :parsOpt "" :argsMin 0 :argsMax 0 :pyInv ""
""" #+begin_org
*  _[[elisp:(blee:menu-sel:outline:popupMenu)][±]]_ _[[elisp:(blee:menu-sel:navigation:popupMenu)][Ξ]]_ [[elisp:(outline-show-branches+toggle)][|=]] [[elisp:(bx:orgm:indirectBufOther)][|>]] *[[elisp:(blee:ppmm:org-mode-toggle)][|N]]*  CmndSvc-   [[elisp:(outline-show-subtree+toggle)][||]] <<readme>>  *Describe*  =verify= ro=cli   [[elisp:(org-cycle)][| ]]
#+end_org """
class readme(cs.Cmnd):
    cmndParamsMandatory = [ ]
    cmndParamsOptional = [ ]
    cmndArgsLen = {'Min': 0, 'Max': 0,}

    @cs.track(fnLoc=True, fnEntry=True, fnExit=True)
    def cmnd(self,
             rtInv: cs.RtInvoker,
             cmndOutcome: b.op.Outcome,
    ) -> b.op.Outcome:
        """Describe"""
        failed = b_io.eh.badOutcome
        callParamsDict = {}
        if self.invocationValidate(rtInv, cmndOutcome, callParamsDict, None).isProblematic():
            return failed(cmndOutcome)
####+END:
        descriptionStr = f"""\
** Scope: Prometheus {prometheusInfo.version} and node_exporter {prometheusInfo.nodeExporterVersion}
   for this host, browsed as {prometheusInfo.baseUrl}

** What this installs:
  1) apt package: curl.
  2) prometheusAcctSetup: the {prometheusInfo.acctName} system account, with uid/gid
     {sysAccts.sysAcctOf(prometheusInfo.acctName).uid} from bisos.banna.sysAccts, and {prometheusInfo.dataDir}.
  3) prometheusDistSetup: {prometheusInfo.distUrl()}
     verified by SHA-256, unpacked root-owned under {prometheusInfo.installBase},
     with {prometheusInfo.homeLink} pointing at it.
  4) nodeExporterDistSetup: {prometheusInfo.nodeExporterUrl()}
     verified by SHA-256, with {prometheusInfo.nodeExporterLink} pointing at it.
  5) prometheusConfSetup: {prometheusInfo.configFile}, {prometheusInfo.envFile} and
     {prometheusInfo.nodeExporterEnvFile} (each written only when absent), then promtool check config.

** Listeners (all loopback; ports from bisos.banna):
     prometheus     {prometheusInfo.localUrl}   (nginx: {prometheusInfo.baseUrl})
     node_exporter  http://{prometheusInfo.nodeExporterAddr}/metrics

** What this does NOT do:
  - It does not start anything. The prometheus and prometheus-node-exporter units are
    declared by prometheus-cbs.pcs, which also runs this sbom (through prometheusCbs-sbom.pcs).
  - It installs nothing for using Prometheus from elsewhere: that is prometheusUsage-sbom.pcs
    (promtool), which this sbom does not pull in.
  - Prometheus has no authentication. It listens on loopback only.

       prometheus-sbom.pcs -i sbom_fullUpdate\
"""
        print(descriptionStr)

        return cmndOutcome.set(
            opError=b.op.OpError.Success,
            opResults=None,
        )


def examples_csu() -> b.op.Outcome:
    """Common Usage Examples for this Command-Service Unit"""

    cmnd = cs.examples.cmndEnter
    literal = cs.examples.execInsert

    cmndOutcome = b.op.Outcome()

    cs.examples.menuChapter('*Prometheus and node_exporter -- sbom Examples*')
    cmnd('readme', comment=" # An overview short description")

    cs.examples.menuChapter('*Installation*')
    literal("prometheus-sbom.pcs -i sbom_fullUpdate")

    cs.examples.menuChapter('*Verify Installation*')
    literal(f"{prometheusInfo.promBin} --version")
    literal(f"{prometheusInfo.nodeExporterBin} --version")
    literal(f"ls -l {prometheusInfo.homeLink} {prometheusInfo.nodeExporterLink}")
    literal(f"sudo -u {prometheusInfo.acctName} {prometheusInfo.promtool} check config {prometheusInfo.configFile}")

    cs.examples.menuChapter('*End-Of Prometheus and node_exporter -- sbom Examples*')
    return cmndOutcome
